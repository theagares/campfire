# Node
node_modules/
npm-debug.log*

# Electron build output
desktop/release/
desktop/dist/

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Chrome extension local QA artifacts (test profiles, large & machine-specific)
extension/.qa/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Env / local secrets
.env
.env.local

# 엔진 로컬 런타임 상태 (탐지 job 메타데이터 store + 감사로그 — 실행할 때마다 생성됨)
engine/app/store/data/

# 실 모델 바이너리 아티팩트(가중치/토크나이저/가제티어 등, 수백MB~수GB — MODELS.md
# 참고해 GitHub Releases로 각자 받기)만 제외한다. app/models/*/runtime/*.py 는 우리가
# 직접 작성/이식한 추론 러타임 코드라 실제 소스코드이므로 여기 포함되지 않게 주의 —
# 아래처럼 바이너리가 든 하위 디렉터리 이름으로 콕 집어서 제외한다(디렉터리 전체를
# 무시하면 그 안의 .py 도 같이 묻혀버리는 실수를 했었음).
engine/app/models/*/models/
engine/app/models/*/attn/
engine/app/models/*/hybrid/
engine/*.egg-info/

# 저장소 루트에 놓인 로컬 전용 아티팩트 — 실수로 커밋되면 GitHub 100MB 파일 제한에
# 걸려 push 자체가 깨진다. PIImodel 은 568MB safetensors 3개(seed42/43/44)를 포함.
/PIImodel/
/INJECTIONmodel/

# 데모/문서용 캡처·이미지 (로컬 보관용)
/image/
/screenshot/

# Claude Code 로컬 작업 공간. worktree(수 GB)와 개인 설정이 들어가므로 기본은 전부
# 로컬 전용으로 본다.
#
# 디렉터리째가 아니라 그 "내용물" 을 무시하는 이유: 디렉터리를 통째로 무시하면 git 이
# 그 안으로 내려가지 않아 예외(!) 지정이 아예 안 먹는다. 나중에 팀이 공유할 설정을
# 커밋하려는 사람이 ! 줄을 넣고도 왜 안 되는지 못 찾게 된다. 공유가 필요해지면 이
# 줄 아래에 그 파일만 되살리는 예외를 추가하면 된다(예: settings.json).
/.claude/*
